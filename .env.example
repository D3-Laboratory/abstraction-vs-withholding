# Copy to .env in the repository root. Only needed to re-run model calls (not for reproduce.py).
# Ollama Cloud API keys, referenced by name from the configurations (credentials.ollama_key_name / ollama_key_pool)
key=
key2=
# OpenRouter API key (GPT-5.6 Luna judge, DeepSeek V4 replays); OPENROUTER_API_KEY in the environment also works
openrouter_key=
# Optional: OLLAMA_API_KEY in the shell environment overrides `key` for single-key runs.
