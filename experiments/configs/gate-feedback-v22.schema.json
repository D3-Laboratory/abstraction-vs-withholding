{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["unnecessary_information", "action"],
  "properties": {
    "unnecessary_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "fix"],
        "properties": {
          "unit": {"type": "string", "minLength": 1},
          "fix": {"enum": ["remove", "generalize"]}
        }
      }
    },
    "action": {"enum": ["PASS_THROUGH", "REQUEST_REVISION"]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "PASS_THROUGH"}}, "required": ["action"]},
      "then": {"properties": {"unnecessary_information": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"action": {"const": "REQUEST_REVISION"}}, "required": ["action"]},
      "then": {"properties": {"unnecessary_information": {"minItems": 1}}}
    }
  ]
}
